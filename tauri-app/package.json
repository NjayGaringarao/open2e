{
  "name": "Open2E",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:tauri": "npm run tauri build --no-bundle",
    "build:installer": "iscc open2e.iss",
    "build:release": "npm run build:tauri && npm run build:installer",
    "load-test:local-eval": "k6 run test/local-evaluation-load-test.js",
    "load-test:local-eval:light": "OLLAMA_URL=http://localhost:11434 k6 run --vus 2 --duration 2m test/local-evaluation-load-test.js",
    "load-test:local-eval:stress": "OLLAMA_URL=http://localhost:11434 k6 run --vus 10 --duration 5m test/local-evaluation-load-test.js"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.22.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@headlessui/react": "^2.2.4",
    "@radix-ui/react-popover": "^1.1.15",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.2",
    "@tauri-apps/plugin-http": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.1",
    "@tauri-apps/plugin-sql": "^2.3.0",
    "@tauri-apps/plugin-store": "^2.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next-themes": "^0.4.6",
    "openai": "^5.10.2",
    "react": "^18.3.1",
    "react-day-picker": "^9.11.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.6.3",
    "recharts": "^3.1.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.0.12",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
